<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <!-- RID only while publishing, so test projects can reference this exe. -->
    <RuntimeIdentifier Condition="'$(_IsPublishing)' == 'true'">win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Edgeless.Core\Edgeless.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <InternalsVisibleTo Include="Edgeless.IntegrationTests" />
  </ItemGroup>
</Project>
